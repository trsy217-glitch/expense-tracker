rules_version = '2';
// 알프스 영업비 정산 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 '게시'하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 대표 계정: 모든 담당자 내역을 보고 승인·반려·지급 완료를 바꿀 수 있는 Google 계정.
    // 다른 계정을 쓰면 이메일을 바꾸고, 여러 명이면 쉼표로 추가하세요.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['aamarketing250611@gmail.com'];
    }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }

    // 담당자 정보 (이름 표시용). 담당자 목록 전체는 대표만 봅니다.
    match /claims/{uid} {
      allow get, write: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
    }
    // 지출 내역: 담당자는 '확인 대기'로만 올리고, 대기 중일 때만 지울 수 있습니다. 상태는 대표만 바꿉니다.
    match /claims/{uid}/items/{id} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSelf(uid) && resource.data.status == 'pending');
    }
    // 영수증 사진 (JPEG 로 줄여 문서에 저장)
    match /claims/{uid}/receipts/{id} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if isSelf(uid) || isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
