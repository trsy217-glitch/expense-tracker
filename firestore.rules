rules_version = '2';
// 알프스 Firestore 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 '게시'하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 우리가게 진단: 로그인한 본인만 읽고 쓰고 지울 수 있습니다 ──
    match /users/{uid}/diagnoses/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size() < 900000;
      allow update: if false;
    }

    // ── 영업비 정산(/expense) ──
    // 대표 계정: 대표님이 로그인할 Google 계정 이메일. 다른 계정을 쓰면 바꾸고, 여러 명이면 쉼표로 추가.
    function isExpenseAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['aamarketing250611@gmail.com'];
    }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }

    // 담당자 정보 (이름 표시용). 담당자 목록 전체(list)는 대표만 봅니다.
    match /claims/{uid} {
      allow get, write: if isSelf(uid) || isExpenseAdmin();
      allow list: if isExpenseAdmin();
    }
    // 지출 내역: 담당자는 '확인 대기'로만 올리고, 대기 중일 때만 지울 수 있습니다. 상태는 대표만 바꿉니다.
    match /claims/{uid}/items/{id} {
      allow read: if isSelf(uid) || isExpenseAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if isExpenseAdmin();
      allow delete: if isExpenseAdmin() || (isSelf(uid) && resource.data.status == 'pending');
    }
    // 영수증 사진
    match /claims/{uid}/receipts/{id} {
      allow read: if isSelf(uid) || isExpenseAdmin();
      allow create, delete: if isSelf(uid) || isExpenseAdmin();
      allow update: if false;
    }

    // 그 밖의 모든 경로는 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
